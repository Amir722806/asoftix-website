# Contact form (used by api/contact.js on Vercel; never expose these to the browser)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM="ASoftix Website <website@your-domain.com>"

# Admin panel (/admin)
ADMIN_PASSWORD=
# Optional: separate signing secret for admin tokens (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Content + inquiry storage on Vercel (Upstash Redis / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
